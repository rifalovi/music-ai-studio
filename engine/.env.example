# Clé API Anthropic — requise pour la couche décision (ai_engineer.py).
# Obtenir une clé : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modèle utilisé par l'ingénieur du son IA (optionnel).
# Défaut : claude-opus-5. Mettre claude-sonnet-5 pour réduire coût/latence.
AI_MODEL=claude-opus-5
